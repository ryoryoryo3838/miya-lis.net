{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": [
    "github:nixos/nixpkgs/nixpkgs-unstable#dune",
    "pnpm@latest",
    "cargo@latest"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null",
      "export DEVBOX_PROMPT_NAME='miya-lis.net(forester)'",
      "source ~/.zshrc",
      "export PATH=\"$HOME/.cargo/bin:$PWD/_build/default/forester/bin/forester:$PWD/_build/install/default/bin:$PATH\""
    ],
    "scripts": {
      "test": [
        "echo \"Error: no test specified\" && exit 1"
      ],
      "setup": "cargo install forest-server"
    }
  }
}
