(version 4.0.0)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune uri)))

(source
 (fetch
  (url
   https://github.com/yawaramin/dream-html/releases/download/v4.0.0/dream-html-4.0.0.tbz)
  (checksum
   sha512=c4cc5e6aa5d230e82c54202e8e6af27e87b4fb055dc3d377df73982ce8c56a27575b02dd01824092aa002a15ac459cb4085d59968da84173406f2500ae80b50b)))
