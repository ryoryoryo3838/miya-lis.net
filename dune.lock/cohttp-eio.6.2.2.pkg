(version 6.2.2)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune base-domains cohttp eio ipaddr logs uri fmt ptime http)))

(source
 (fetch
  (url
   https://github.com/mirage/ocaml-cohttp/releases/download/v6.2.2/cohttp-6.2.2.tbz)
  (checksum
   sha256=499cd8b094cee4b00fe6b9f6322680f81fe87161e963a196b109c1882610af62)))
