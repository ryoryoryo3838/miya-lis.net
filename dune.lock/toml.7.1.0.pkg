(version 7.1.0)

(build
 (all_platforms
  ((action
    (withenv
     ((= TZ ""))
     (progn
      (when %{pkg-self:dev} (run dune subst))
      (run dune build -p %{pkg-self:name} -j %{jobs} @install)))))))

(depends
 (all_platforms
  (dune ocaml menhir ISO8601)))

(source
 (fetch
  (url https://github.com/ocaml-toml/to.ml/archive/7.1.0.tar.gz)
  (checksum
   sha512=9cb98e4a9c4a01acf5ceeac836fe0dc4d341662f9b3ce6803e9d14499bcb450441111247159bdbc5c25d4618b8c1f088d206da702bef12ea1ca8781607d26774)))
