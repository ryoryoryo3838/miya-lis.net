// wrangler.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miya-lis-forest",
  "compatibility_date": "2026-08-09",
  "assets": {
    "directory": "./site/output",
    // The forest is a real multi-page tree: every route is a directory with an
    // index.html, and the default html_handling already maps /aboutme to
    // /aboutme/index.html. Serving the root entry for anything missing would
    // answer 200 with the hero page for every dead link. The safe-web artifact
    // carries a trusted 404.html, so a miss (including the /_unavailable/
    // target of private placements) answers it with status 404.
    "not_found_handling": "404-page"
  }
}
